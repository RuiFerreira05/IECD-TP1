<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="config">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="defaultPort" type="xs:positiveInteger" minOccurs="0"/>
                <xs:element name="maxFrameSize" type="xs:positiveInteger" minOccurs="0"/>
                <xs:element name="sessionTimeoutSeconds" type="xs:positiveInteger" minOccurs="0"/>
                <xs:element name="userStore" type="xs:string" minOccurs="0"/>
                <xs:element name="leaderboardStore" type="xs:string" minOccurs="0"/>
                <xs:element name="protocolVersion" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
</xs:schema>